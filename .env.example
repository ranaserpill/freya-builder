# Copy to .env (never commit .env)
# Names must match kit/freya.py and kit/tools/score.py
FREYA_API_KEY=
FREYA_API_URL=https://staging-app.freyavoice.ai
# Any secret of 16+ characters; the whole team uses the same one every time
FREYA_BANK_TEAM_KEY=
# LLM the builder itself calls (we pay for it)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Your personal dev workflow name, e.g. dev-rana / dev-sevval
DEV_WORKFLOW_NAME=
